{
  "name": "@blazion/plugin-auth",
  "version": "1.0.0",
  "description": "Auth-refresh plugin for Blazion — single-flight token refresh and retry on 401",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "blazion",
    "auth",
    "token-refresh",
    "401",
    "plugin"
  ],
  "peerDependencies": {
    "@blazion/core": ">=1.0.0"
  },
  "scripts": {
    "build": "tsc --build && tsup",
    "lint": "eslint src --fix"
  }
}
