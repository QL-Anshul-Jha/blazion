#!/usr/bin/env sh

# ━━━ Domain Guard: Only @quokkalabs.com emails can commit ━━━
EMAIL=$(git config user.email)
DOMAIN="@quokkalabs.com"

if echo "$EMAIL" | grep -qv "$DOMAIN$"; then
  echo ""
  echo "❌ COMMIT BLOCKED"
  echo "   Your email: $EMAIL"
  echo "   Required domain: *$DOMAIN"
  echo ""
  echo "   Fix it with:"
  echo "   git config user.email \"yourname$DOMAIN\""
  echo ""
  exit 1
fi

npx lint-staged || exit 1

# ━━━ Build Guard: never let a broken build get committed ━━━
echo ""
echo "🔨 Verifying build..."
if ! npm run build --silent; then
  echo ""
  echo "❌ COMMIT BLOCKED — build failed. Fix the errors above before committing."
  echo ""
  exit 1
fi
