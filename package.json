{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node scripts/preinstall.js",
    "prepare": "husky",
    "lint": "npm run lint --workspaces",
    "build": "npm run build --workspaces",
    "pretest": "npm run build",
    "test": "node --import tsx --test $(find packages -path '*/src/*.test.ts')",
    "start": "tsx packages/core/src/test.ts"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tsx": "^4.23.0",
    "typescript": "^5.0.0"
  }
}
